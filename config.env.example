# Contoh konfigurasi. Salin dulu:
#   cp config.env.example config.env
# lalu edit config.env. File config.env tidak ikut ter-commit.

# APN operator. Contoh:
#   Telkomsel : internet
#   Indosat   : indosatgprs
#   XL        : internet
#   Tri (3)   : 3gprs
#   Smartfren : internet
#   by.U      : internet
APN="internet"

# Nama profil NetworkManager yang dibuat script.
CONNECTION_NAME="wwan"

# Metric route. Angka lebih kecil = lebih diprioritaskan.
# 700 = biarkan WiFi jadi jalur utama.
# 100 = paksa WWAN jadi jalur utama.
ROUTE_METRIC="700"

# PIN SIM. Kosongkan kalau SIM tidak memakai PIN.
PIN=""

# Index modem ModemManager. Biasanya 0.
MODEM_ID="0"

# Target tes ping setelah connect.
PING_TARGET="1.1.1.1"
