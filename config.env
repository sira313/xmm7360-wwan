# Konfigurasi koneksi WWAN.
# File ini dibaca oleh scripts/wwan. Ubah sesuai operator/SIM kamu.

# APN operator. Contoh:
#   Telkomsel : internet
#   Indosat   : indosatgprs
#   XL        : internet
#   Tri (3)   : 3gprs
#   Smartfren : internet
#   by.U      : internet
APN="internet"

# Nama profil NetworkManager yang dibuat script.
# Di mesin ini profil yang sudah terbukti bekerja bernama "telkomsel".
CONNECTION_NAME="telkomsel"

# Metric route. Angka lebih kecil = lebih diprioritaskan.
# 700 = biarkan WiFi jadi jalur utama.
# 100 = paksa WWAN jadi jalur utama.
ROUTE_METRIC="700"

# PIN SIM. Kosongkan kalau SIM tidak memakai PIN.
PIN=""

# Index modem ModemManager. Biasanya 0.
MODEM_ID="0"

# Target tes ping setelah connect.
PING_TARGET="1.1.1.1"
